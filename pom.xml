	<groupId>nl.uu.science.cellbiology</groupId>
	<artifactId>bigvolumebrowser</artifactId>
	<version>0.1.4-SNAPSHOT</version>

	<name>BigVolumeBrowser</name>
	<description>browsing large volumetric data</description>
	<url>https://github.com/UU-cellbiology/bigvolumebrowser</url>
	<inceptionYear>2025</inceptionYear>
	<organization>
		<name>Cell Biology, Neurobiology and Biophysics Department of Utrecht University</name>
		<url>https://cellbiology.science.uu.nl/</url>
	</organization>
	
	<licenses>
		<license>
			<name>Simplified BSD License</name>
			<url>https://opensource.org/licenses/BSD-2-Clause</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

    <developers>
        <developer>
            <id>ekatrukha</id>
            <name>Eugene Katrukha</name>
            <url>https://imagej.net/people/ekatrukha</url>
            <roles>
       			<role>founder</role>
				<role>lead</role>
				<role>developer</role>
				<role>debugger</role>
				<role>reviewer</role>
				<role>support</role>
				<role>maintainer</role>
            </roles>
        </developer>
    </developers>
    
  	<contributors>
		<contributor>
			<name>TODO</name>
		</contributor>
	</contributors>	
	
	<mailingLists>
		<mailingList>
			<name>Image.sc Forum</name>
			<archive>https://forum.image.sc/tag/imglib2</archive>
		</mailingList>
	</mailingLists>

    <scm>
        <connection>scm:git:git://github.com/UU-cellbiology/bigvolumebrowser</connection>
        <developerConnection>scm:git:git@github.com:UU-cellbiology/bigvolumebrowser</developerConnection>
        <tag>bigvolumebrowser-0.1.4</tag>
        <url>https://github.com/UU-cellbiology/bigvolumebrowser</url>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>http://github.com/UU-cellbiology/bigvolumebrowser/issues</url>
    </issueManagement>
    <ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/UU-cellbiology/bigvolumebrowser/actions</url>
    </ciManagement>

	<properties>
		<package-name>bvb</package-name>    
		<license.licenseName>bsd_2</license.licenseName>
        <license.copyrightOwners>Cell Biology, Neurobiology and Biophysics Department of Utrecht University.</license.copyrightOwners>  			
		<license.excludes>**/resources/**</license.excludes>
		<bvv-playground.version>0.5.7</bvv-playground.version>
		<bdv-loaders.version>0.10.0</bdv-loaders.version>
		<jgltf.version>2.0.4</jgltf.version>
		<laszip4j.version>0.20</laszip4j.version>
		<!-- NB: Deploy releases to the SciJava Maven repository. -->
		<releaseProfiles>sign,deploy-to-scijava</releaseProfiles> 
		
	</properties>

	<dependencies>
		<dependency>
		  <groupId>nl.uu.science.cellbiology</groupId>
		  <artifactId>bvv-playground</artifactId>
		  <version>${bvv-playground.version}</version>
		</dependency>
		
		<dependency>
			<groupId>com.formdev</groupId>
			<artifactId>flatlaf</artifactId>
		</dependency>
		
		<!-- BIOFORMATS -->
		<dependency>
			<groupId>ome</groupId>
			<artifactId>bio-formats_plugins</artifactId>
			<exclusions>
				<exclusion><!-- NB: Exclude problematic uber-JAR that bundles commons-io. -->
					<groupId>ch.systems.cisd</groupId>
					<artifactId>jhdf5</artifactId>
				</exclusion>
			</exclusions>
		</dependency>			
		
		<!-- BDV Image Loaders -->
		<dependency>
			<groupId>ch.epfl.biop</groupId>
			<artifactId>bigdataviewer-image-loaders</artifactId>
			<version>${bdv-loaders.version}</version> 
		</dependency>
		
		<!-- N5 Utils -->
		<dependency>
            <groupId>org.janelia.saalfeldlab</groupId>
            <artifactId>n5</artifactId>
        </dependency>
        
         <dependency>
            <groupId>org.janelia.saalfeldlab</groupId>
            <artifactId>n5-universe</artifactId>
        </dependency>
        
		<dependency>
		  <groupId>org.janelia.saalfeldlab</groupId>
		  <artifactId>n5-viewer_fiji</artifactId>
		</dependency>
		<!-- GLT format (mesh) reader -->
		<dependency>
		    <groupId>de.javagl</groupId>
		    <artifactId>jgltf-model</artifactId>
		    <version>${jgltf.version}</version>
		</dependency>
		
		<!-- LAS Reader -->
		<dependency>
			<groupId>com.github.mreutegg</groupId>
  			<artifactId>laszip4j</artifactId>
  			<version>${laszip4j.version}</version>
		</dependency>
		
		<!-- Animation timeline storage -->
  		<dependency>
		 <groupId>com.fasterxml.jackson.core</groupId>
		  <artifactId>jackson-core</artifactId>
		</dependency>
		
  		<dependency>
		 <groupId>com.fasterxml.jackson.core</groupId>
		  <artifactId>jackson-databind</artifactId>
		</dependency>
		
		
		<!-- ImgLib2 dependencies -->
		<dependency>
			<groupId>net.imglib2</groupId>
			<artifactId>imglib2</artifactId>
		</dependency>
		
		<dependency>
			<groupId>net.imglib2</groupId>
			<artifactId>imglib2-algorithm</artifactId>
		</dependency>

		<dependency>
			<groupId>net.imglib2</groupId>
			<artifactId>imglib2-realtransform</artifactId>
		</dependency>
		
		<dependency>
			<groupId>net.imglib2</groupId>
			<artifactId>imglib2-cache</artifactId>
		</dependency>

		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>ui-behaviour</artifactId>
		</dependency>
		<dependency>
			<groupId>org.jogamp.jogl</groupId>
			<artifactId>jogl-all</artifactId>
		</dependency>
		<dependency>
			<groupId>org.joml</groupId>
			<artifactId>joml</artifactId>
		</dependency>
		
		<dependency>
		    <groupId>net.imglib2</groupId>
		    <artifactId>imglib2-mesh</artifactId>
		</dependency>
		
		<!-- BDV dependencies -->
		<dependency>
			<groupId>sc.fiji</groupId>
			<artifactId>bigdataviewer-core</artifactId>
		</dependency>
		
		<dependency>
			<groupId>sc.fiji</groupId>
			<artifactId>spim_data</artifactId>
		</dependency>
		
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>ij</artifactId>
		</dependency>
	</dependencies>
	
	<repositories>		
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>
	
</project>
